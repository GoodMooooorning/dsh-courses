{
  "name": "priestess-styled-theme",
  "version": "1.0.0",
  "description": "普瑞塞斯 · 源石协议 — Arknights (Priestess/Originium) theme for DSH Web, plugin form. Workspace-scoped; survives dsh updates.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
