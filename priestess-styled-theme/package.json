{
  "name": "priestess-styled-theme",
  "version": "2.0.1",
  "description": "普瑞赛斯 · 源石协议 — Arknights (Priestess/Originium) theme for the DSH Web GUI, packaged as a client plugin. Survives dsh upgrades.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tests",
    "cordis.patch.yml",
    "manage.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT"
}
