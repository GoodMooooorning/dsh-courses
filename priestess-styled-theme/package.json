{
  "name": "priestess-styled-theme",
  "version": "1.1.0",
  "description": "普瑞赛斯 · 源石协议 — Arknights (Priestess/Originium) theme for DSH Web, plugin form. Workspace-scoped; survives dsh updates.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale",
        "connection",
        "remote",
        "settingsScope"
      ]
    }
  },
  "license": "MIT"
}
